    "test:fixtures": "node scripts/release/run-suite.mjs fixtures",
    "test:browser": "node scripts/release/run-suite.mjs browser",
    "test:e2e": "node scripts/release/run-suite.mjs e2e",
    "test:accessibility": "node scripts/release/run-suite.mjs accessibility",
    "test:security": "node scripts/release/run-suite.mjs security",
    "test:release": "node scripts/release/release.mjs",
    "evaluate:packet11": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run --no-file-parallelism src/ai/evaluation/packet-11-live-kie.test.ts",
