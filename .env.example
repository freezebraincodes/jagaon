# =====================================================================================================================================
# JagaOn environment variables (template)
#
# Copy to `.env.local` for local development, and set the same names in Vercel → Project → Settings → Environment Variables.
# Never commit real keys. Server-only values are never sent to the browser. `NEXT_PUBLIC_*` values ARE built into the browser bundle,
# so they must never hold a secret, and changing one needs a rebuild/redeploy.
#
# Switches are "on" only for the exact value `on`; anything else (or unset) is off.
# Allowed-origin lists are exact origins, comma separated, no path or wildcard (e.g. https://jagaon.vercel.app,http://localhost:3000).
# =====================================================================================================================================


# -------------------------------------------------------------------------------------------------------------------------------------
# 1. AI provider (server-only, secret)
# -------------------------------------------------------------------------------------------------------------------------------------
# DeepSeek API key: used by every AI feature (History explanation, visit-summary wording, feelings chat, medicine information and
# voice transcript reading). Without it, JagaOn keeps its standard wording and nothing is sent.
DEEPSEEK_API_KEY=


# -------------------------------------------------------------------------------------------------------------------------------------
# 2. AI wording: History explanation and "Organise with AI" on the visit summary (server-only)
# -------------------------------------------------------------------------------------------------------------------------------------
# Master switch for every remote AI call. `on` to allow; anything else keeps all AI off (standard wording only).
JAGAON_REMOTE_AI=on

# Pages allowed to call the AI routes (origin protection, not authentication). Include every place the app runs.
JAGAON_AI_ALLOWED_ORIGINS=https://jagaon.vercel.app,http://localhost:3000

# Optional demo passcode asked before AI is used (8–128 visible characters). Leave empty for no passcode.
JAGAON_AI_DEMO_PASSCODE=

# Daily spend cap for AI wording, in USD (per server instance, best effort). Requests stop for the day once it is reached.
JAGAON_AI_DAILY_SPEND_LIMIT_USD=0.50


# -------------------------------------------------------------------------------------------------------------------------------------
# 3. Other AI features (server-only). Each also needs JAGAON_REMOTE_AI=on and DEEPSEEK_API_KEY.
# -------------------------------------------------------------------------------------------------------------------------------------
# "Talk it through" feelings chat in Tell JagaOn (reflective questions, never advice; distress always goes to helplines first).
JAGAON_AI_FEELINGS_CHAT=on
JAGAON_AI_FEELINGS_DAILY_SPEND_LIMIT_USD=1

# "Get general information with AI" for a medicine (HSA preview feature; only the medicine name is sent).
JAGAON_AI_MEDICINE_INFO=on
JAGAON_AI_MEDICINE_INFO_DAILY_SPEND_LIMIT_USD=1

# Optional: "Ask AI to help read what you said" in Tell JagaOn. Leave empty to keep reading on the device only.
JAGAON_AI_TRANSCRIPT_EXTRACTION=
JAGAON_AI_TRANSCRIPT_DAILY_SPEND_LIMIT_USD=


# -------------------------------------------------------------------------------------------------------------------------------------
# 4. Voice: Tell JagaOn speech-to-text (server-only)
# -------------------------------------------------------------------------------------------------------------------------------------
# Master switch for voice. `on` to allow speaking to Tell JagaOn; typing always works.
JAGAON_VOICE_CLOUD=on

# Voice engines, in order of preference: `trtc` (Tencent Real-Time Communication) and/or `webspeech` (the browser's own speech
# recognition, used as the fallback when the TRTC daily limit is reached). Unset means `trtc` only.
JAGAON_VOICE_PROVIDERS=trtc,webspeech

# Pages allowed to request a voice session (origin protection, not authentication).
JAGAON_VOICE_ALLOWED_ORIGINS=https://jagaon.vercel.app,http://localhost:3000

# Optional voice passcode (8–128 visible characters). Leave empty for no passcode.
JAGAON_VOICE_DEMO_PASSCODE=

# Longest single recording, in seconds (10–900). 60 is a good fit for one spoken entry.
JAGAON_VOICE_MAX_SESSION_SECONDS=60

# Set to `on` only on Vercel: trusts Vercel's client-address header so wrong passcodes are throttled per person, not for everyone.
# Leave empty locally (the header can be forged there).
JAGAON_TRUST_VERCEL_CLIENT_IP=on


# -------------------------------------------------------------------------------------------------------------------------------------
# 5. Tencent TRTC credentials (needed only when JAGAON_VOICE_PROVIDERS includes `trtc`)
# -------------------------------------------------------------------------------------------------------------------------------------
# From the Tencent Cloud TRTC console. The secret key is server-only and used only to sign short-lived UserSig tokens.
TRTC_SDK_APP_ID=YOUR_NUMERIC_SDK_APP_ID
TRTC_SDK_SECRET_KEY=YOUR_SDK_SECRET_KEY

# Lifetime of each signed UserSig token, in seconds (60–3600).
JAGAON_VOICE_USERSIG_TTL_SECONDS=120

# Daily cap on TRTC voice minutes (1–10000, per server instance). When reached, the app offers browser speech recognition instead.
JAGAON_VOICE_DAILY_MINUTES_LIMIT=100

# Build-time only. Do NOT set this for the hackathon build: `JAGAON_BUILD_EXCLUDE_TRTC=1` leaves the Tencent TRTC SDK out of the app
# entirely (voice then works only through `webspeech`).
# JAGAON_BUILD_EXCLUDE_TRTC=1


# -------------------------------------------------------------------------------------------------------------------------------------
# 6. Maps (server-only, optional)
# -------------------------------------------------------------------------------------------------------------------------------------
# OneMap access token for place search in Food information → nearby food. Without it, postal-code search and the HPB list still work.
ONEMAP_ACCESS_TOKEN=


# -------------------------------------------------------------------------------------------------------------------------------------
# 7. Build-time display flags (NEXT_PUBLIC_*: public, built into the browser bundle; change needs a redeploy)
# -------------------------------------------------------------------------------------------------------------------------------------
# `on` shows the "System" section in More → Settings (pick the voice engine). Leave empty for a clean public build.
NEXT_PUBLIC_JAGAON_DEV_SETTINGS=

# HSA-bounded mode switch in Settings. Leave empty to show the switch (judges can preview HSA-boundary features);
# `off` hides the switch and keeps the app always within the HSA wellness boundary (public release).
NEXT_PUBLIC_JAGAON_HSA_PREVIEW=

# Starting position of HSA-bounded mode on a device that has not chosen yet. Leave empty to start bounded (recommended);
# `off` starts every new device in preview mode.
NEXT_PUBLIC_JAGAON_HSA_BOUNDED_DEFAULT=


# -------------------------------------------------------------------------------------------------------------------------------------
# Not used by the app (kept only for older offline evaluation scripts): KIE_API_KEY, HYBRID_*, KIE_EVALUATION_*, RUN_LIVE_*.
# Do not set them on Vercel.
# -------------------------------------------------------------------------------------------------------------------------------------
